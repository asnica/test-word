<h1>単語詳細</h1>

<p>
  <strong>単語:</strong>
  <%= @word.word %>
</p>

<p>
  <strong>意味:</strong>
  <%= @word.meaning %>
</p>

<p>
  <strong>タグ:</strong>

<% if @word.tags.any? %>
<% @word.tags.each do |tag| %>
<%= tag.name %>
<% end %>
<% else %>
タグなし
<% end %>

</p>

<%= link_to "編集", edit_word_path(@word) %>
<%= link_to "一覧に戻る", words_path %>

<p>
  <strong>類義語:</strong>

  <% if @word.synonyms.any? %>
    <% @word.synonyms.each do |synonym| %>
      <%= synonym.name %>
    <% end %>
  <% else %>
    類義語なし
  <% end %>
</p>

<p>
  <strong>画像:</strong>
</p>

<% if @word.image.attached? %>
  <%= image_tag @word.image, style: "max-width: 300px; height: auto;" %>
<% else %>
  <p>画像なし</p>
<% end %>