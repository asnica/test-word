<h1>単語を編集</h1>

<% if @word.errors.any? %>

  <div>
    <h2>更新に失敗しました</h2>
    <ul>
      <% @word.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @word do |form| %>

  <div>
    <%= form.label :word, "単語" %>
    <%= form.text_field :word %>
  </div>

  <div>
    <%= form.label :meaning, "意味" %>
    <%= form.text_field :meaning %>
  </div>

  <div>
  <%= form.label :image, "画像" %>
  <%= form.file_field :image, accept: "image/*" %>
</div>

  <div>
    <p>タグ</p>

    <%= hidden_field_tag "tag_ids[]", "" %>

    <% @tags.each do |tag| %>
  <div>
    <%= check_box_tag "tag_ids[]",
                      tag.id,
                      @word.tag_ids.include?(tag.id),
                      id: "tag_#{tag.id}" %>

    <%= label_tag "tag_#{tag.id}", tag.name %>
  </div>
<% end %>

<div data-controller="synonyms">
  <%= form.label :synonyms, "類義語" %>

  <div id="synonyms">
    <%= form.fields_for :synonyms do |synonym_form| %>
      <%= render "synonym_fields", synonym_form: synonym_form %>
    <% end %>
  </div>

  <button type="button" data-action="click->synonyms#add">
    類義語を追加
  </button>

  <template id="synonym-template">
    <div class="synonym-field">
      <input
        type="text"
        name="word[synonyms_attributes][NEW_RECORD][name]"
        id="word_synonyms_attributes_NEW_RECORD_name"
      >

      <input
        type="hidden"
        name="word[synonyms_attributes][NEW_RECORD][_destroy]"
        id="word_synonyms_attributes_NEW_RECORD__destroy"
        value="0"
      >

      <button type="button" data-action="click->synonyms#remove">
        削除
      </button>
    </div>
  </template>
</div>

  </div>

  <div>
    <%= form.submit "更新" %>
  </div>
<% end %>
