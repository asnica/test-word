<h1>新しい単語を登録</h1>

<% if @word&.errors&.any? %>
  <div>
    <h2>登録に失敗しました</h2>
    <ul>
      <% @word.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: words_path, method: :post do |form| %>
  <div>
    <%= form.label :word, "単語" %>
    <%= form.text_field :word %>
  </div>

  <div>
    <%= form.label :meaning, "意味" %>
    <%= form.text_field :meaning %>
  </div>

  <div>
    <%= form.submit "登録" %>
  </div>
<% end %>
