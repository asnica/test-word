<%# sessions画面を押下するボタンなどを作成するための〜 %>
<h1>ログイン</h1>

<% if flash[:alert] %>
  <div>
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with url: login_path, method: :post do |form| %>
  <div>
    <%= form.label :email, "メールアドレス" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password %>
  </div>

  <div>
    <%= form.submit "ログイン" %>
  </div>
<% end %>

<%= link_to "新しいユーザーを登録", users_new_path %>
<%# login画面に新規ユーザーを登録するためのリンクを作成するためのコード %>